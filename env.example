# Auth Service API Base URL
NEXT_PUBLIC_AUTH_API=https://auth.bagdja.com

# Client App Credentials
NEXT_PUBLIC_CLIENT_APP_ID=user-console
NEXT_PUBLIC_CLIENT_APP_SECRET=<isi dari bagdja-auth, jangan di-commit>

# Bagdja Login Service URL (Centralized Login)
NEXT_PUBLIC_LOGIN_URL=http://localhost:3000

# Log Service API Base URL
NEXT_PUBLIC_LOG_API=http://localhost:3002

# Messaging Service API Base URL (wajib untuk tab Messaging halaman App)
NEXT_PUBLIC_MESSAGE_API=http://localhost:4086

# Optional: Frontend URL (for development)
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# Server-only (JANGAN pakai prefix NEXT_PUBLIC_): kunci enkripsi state OAuth.
# Buat dengan: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
